# Comma-separated RSS feeds (tech/finance examples)
RSS_FEEDS=https://feeds.a.dj.com/rss/RSSMarketsMain.xml,https://www.theverge.com/rss/index.xml,https://techcrunch.com/feed/

# Optional API for richer coverage
NEWSAPI_KEY=

# Output controls
MAX_ITEMS_PER_SOURCE=8
OUTPUT_DIR=data/drafts
TARGET_LANGUAGE=ja
DEFAULT_AUDIENCE=日本の読者

# Grok (xAI) summarization — https://console.x.ai
# When unset, falls back to the rule-based translate+truncate summarizer.
XAI_API_KEY=
GROK_MODEL=grok-4-fast

# Security-alert email notifications (Gmail SMTP with an App Password)
# When SMTP_USER/SMTP_PASSWORD/NOTIFY_EMAIL_TO are unset, no email is sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
